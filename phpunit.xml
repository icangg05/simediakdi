<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Postgres, bukan sqlite: skema memakai pgvector, index hnsw,
             UNIQUE NULLS NOT DISTINCT, dan ilike. Menguji di sqlite berarti
             menguji skema yang berbeda dari yang dijalankan di produksi. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="simedia_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Database sudah terpisah ke simedia_test, filesystemnya belum, dan
            itu terbukti berbahaya. Ekspor dataset menamai direktorinya
            `snapshot-{id}`, dan id snapshot di tes berjalan pada deret yang
            sama dengan pengembangan. Satu tes yang mengekspor snapshot id 1
            akan menimpa dataset asli milik snapshot terkunci, yaitu berkas
            yang justru dijamin tidak berubah oleh manifest hash-nya.
        -->
        <env name="RELEVANSI_DATASET_PATH" value="storage/framework/testing/relevance-datasets"/>
        <env name="RELEVANSI_ARTEFAK_PATH" value="storage/framework/testing/relevance-models"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
