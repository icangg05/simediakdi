APP_TIMEZONE=Asia/Makassar
APP_NAME="SIMEDIA Kendari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=simedia
DB_USERNAME=simedia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Klasifikasi relevansi dan sentimen lewat Gemini. Dokumen 13.
#
# Kunci diambil dari Google AI Studio. Jangan pernah di-commit, jangan disimpan
# di database, jangan ditampilkan di halaman admin, dan jangan dicetak ke log.
# Pakai kunci berbeda untuk development dan production.
#
# Free tier boleh memakai isi permintaan untuk peningkatan produk, jadi yang
# dikirim hanya artikel media yang memang sudah publik.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=60

# Nama berkas di resources/prompts, tanpa akhiran .txt. Naikkan versinya saat
# isi prompt berubah, jangan menyunting berkas versi lama, karena hasil lama
# menunjuk ke nama ini untuk menjelaskan dirinya.
AI_RELEVANCE_PROMPT_VERSION=relevance-v1
AI_SENTIMENT_PROMPT_VERSION=sentiment-v1

DEDUP_AMBANG_SIMHASH=12

CRAWL_USER_AGENT="SimediaKendariBot/1.0 (+https://simedia.kendarikota.go.id/bot)"
CRAWL_DELAY_MS=1500
CRAWL_TIMEOUT=20
CRAWL_WORDPRESS_API=true

# Layanan tangkapan layar bukti pemuatan. Loopback saja, tanpa endpoint publik.
ARSIP_BASE_URL=http://arsip:8002
ARSIP_TIMEOUT=45

# Minta chat ID grup Diskominfo lebih dulu, lalu uji lewat /admin/alert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
